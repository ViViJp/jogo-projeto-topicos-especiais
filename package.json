{
  "name": "flesh-to-chrome",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo wrapper — o jogo oficial está em ./flesh-to-chrome",
  "scripts": {
    "dev": "npm --prefix flesh-to-chrome run dev",
    "dev:multiplayer": "npm --prefix flesh-to-chrome run dev:multiplayer",
    "signaling": "npm --prefix flesh-to-chrome run signaling",
    "start": "npm --prefix flesh-to-chrome run start",
    "build": "npm --prefix flesh-to-chrome run build",
    "typecheck": "npm --prefix flesh-to-chrome run typecheck",
    "test": "npm run typecheck && npm run validate:assets && npm run test:gameplay && npm run test:multiplayer",
    "test:gameplay": "npm --prefix flesh-to-chrome run test:gameplay",
    "test:multiplayer": "npm --prefix flesh-to-chrome run test:multiplayer",
    "validate:assets": "npm --prefix flesh-to-chrome run validate:assets",
    "postinstall": "npm --prefix flesh-to-chrome install"
  }
}
