import { MqttClient, MqttConnectionState } from "./MqttClient";
import {
  createPlayerId,
  createRoomId,
  decodeRoomMessage,
  encodeRoomMessage,
  roomTopic,
  RoomMessage,
} from "./MultiplayerProtocol";

export type RoomRole = "host" | "player";

export interface RoomState {
  roomId: string;
  playerId: string;
  role: RoomRole;
  connection: MqttConnectionState;
}

export class Room {
  private readonly mqtt: MqttClient;
  private readonly playerId: string;
  private roomId?: string;
  private role?: RoomRole;
  private hostId?: string;
  private readonly listeners = new Set<(state: RoomState) => void>();
  private readonly messageListeners = new Set<(message: RoomMessage) => void>();
  private unsubscribeState: () => void;
  private unsubscribeMessage: () => void;

  constructor(mqtt: MqttClient, playerId = createPlayerId()) {
    this.mqtt = mqtt;
    this.playerId = playerId;
    this.unsubscribeState = mqtt.onState((state) => this.emitState(state));
    this.unsubscribeMessage = mqtt.onMessage((message) => this.handleMessage(message.topic, message.payload));
  }

  onState(listener: (state: RoomState) => void): () => void {
    this.listeners.add(listener);
    return () => this.listeners.delete(listener);
  }

  onMessage(listener: (message: RoomMessage) => void): () => void {
    this.messageListeners.add(listener);
    return () => this.messageListeners.delete(listener);
  }

  get state(): RoomState | undefined {
    if (!this.roomId || !this.role) return undefined;
    return {
      roomId: this.roomId,
      playerId: this.playerId,
      role: this.role,
      connection: this.mqtt.state,
    };
  }

  get playerIdValue(): string {
    return this.playerId;
  }

  create(): string {
    const roomId = createRoomId();
    this.join(roomId, "host");
    return roomId;
  }

  join(roomId: string, role: RoomRole = "player"): void {
    const normalized = roomId.trim().toUpperCase();
    if (!/^[A-Z0-9]{6}$/.test(normalized)) {
      throw new Error("O código da sala deve ter 6 caracteres.");
    }

    if (this.roomId) this.leave();
    this.roomId = normalized;
    this.role = role;
    this.hostId = role === "host" ? this.playerId : undefined;

    this.mqtt.subscribe(roomTopic(normalized));
    this.mqtt.connect();

    if (this.mqtt.state === "online") this.publishHello();
    this.emitState(this.mqtt.state);
  }

  leave(): void {
    if (this.roomId) {
      this.mqtt.publish(roomTopic(this.roomId), encodeRoomMessage({ type: "room_leave", playerId: this.playerId }));
    }
    this.roomId = undefined;
    this.role = undefined;
    this.hostId = undefined;
    this.mqtt.disconnect();
  }

  destroy(): void {
    this.unsubscribeState();
    this.unsubscribeMessage();
    this.leave();
    this.listeners.clear();
    this.messageListeners.clear();
  }

  private handleMessage(topic: string, payload: string): void {
    if (!this.roomId || topic !== roomTopic(this.roomId)) return;
    const message = decodeRoomMessage(payload);
    if (!message || message.playerId === this.playerId) return;

    if (message.type === "room_hello" && this.role === "host") {
      this.mqtt.publish(topic, encodeRoomMessage({ type: "room_welcome", playerId: this.playerId, hostId: this.playerId }));
      this.mqtt.publish(topic, encodeRoomMessage({ type: "room_presence", playerId: this.playerId, role: "host" }));
    }

    if (message.type === "room_welcome" && this.role === "player") {
      this.hostId = message.hostId;
    }

    for (const listener of this.messageListeners) listener(message);
  }

  private publishHello(): void {
    if (!this.roomId || !this.role) return;
    this.mqtt.publish(roomTopic(this.roomId), encodeRoomMessage({ type: "room_hello", playerId: this.playerId }));
    this.mqtt.publish(roomTopic(this.roomId), encodeRoomMessage({ type: "room_presence", playerId: this.playerId, role: this.role }));
  }

  private emitState(connection: MqttConnectionState): void {
    if (!this.roomId || !this.role) return;
    const state: RoomState = {
      roomId: this.roomId,
      playerId: this.playerId,
      role: this.role,
      connection,
    };
    for (const listener of this.listeners) listener(state);
    if (connection === "online") this.publishHello();
  }
}
