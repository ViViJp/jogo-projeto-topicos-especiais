import mqtt, { MqttClient as MqttJsClient } from "mqtt";

export type MqttConnectionState = "offline" | "connecting" | "online" | "reconnecting";

export interface MqttMessage {
  topic: string;
  payload: string;
}

export interface MqttClientOptions {
  url: string;
  clientId: string;
  keepAliveSeconds?: number;
  reconnectDelayMs?: number;
}

export type MqttStateListener = (state: MqttConnectionState, detail?: string) => void;
export type MqttMessageListener = (message: MqttMessage) => void;

/**
 * Adaptador MQTT do jogo.
 *
 * O protocolo MQTT/WebSocket é delegado ao MQTT.js. Isso evita manter uma
 * implementação manual dos pacotes MQTT no navegador e garante CONNECT,
 * SUBSCRIBE, PUBLISH, PINGREQ/PINGRESP e reconexão corretos.
 */
export class MqttClient {
  private client?: MqttJsClient;
  private readonly subscriptions = new Set<string>();
  private readonly stateListeners = new Set<MqttStateListener>();
  private readonly messageListeners = new Set<MqttMessageListener>();
  private readonly options: Required<MqttClientOptions>;
  private manuallyClosed = false;

  public state: MqttConnectionState = "offline";

  constructor(options: MqttClientOptions) {
    this.options = {
      keepAliveSeconds: 30,
      reconnectDelayMs: 1500,
      ...options,
    };
  }

  onState(listener: MqttStateListener): () => void {
    this.stateListeners.add(listener);
    return () => this.stateListeners.delete(listener);
  }

  onMessage(listener: MqttMessageListener): () => void {
    this.messageListeners.add(listener);
    return () => this.messageListeners.delete(listener);
  }

  connect(): void {
    if (this.client && (this.client.connected || this.client.reconnecting)) return;

    this.manuallyClosed = false;
    this.setState(this.client ? "reconnecting" : "connecting");

    this.client = mqtt.connect(this.options.url, {
      clientId: this.options.clientId,
      protocolVersion: 4,
      clean: true,
      keepalive: this.options.keepAliveSeconds,
      reconnectPeriod: this.options.reconnectDelayMs,
      connectTimeout: 5000,
      resubscribe: true,
    });

    this.client.on("connect", () => {
      if (this.manuallyClosed) return;
      this.setState("online");

      // MQTT.js também resubscreve automaticamente, mas manter esta lista
      // garante que uma inscrição feita antes da conexão seja restaurada.
      for (const topic of this.subscriptions) {
        this.client?.subscribe(topic, { qos: 0 });
      }
    });

    this.client.on("reconnect", () => {
      if (!this.manuallyClosed) this.setState("reconnecting", "Tentando reconectar...");
    });

    this.client.on("close", () => {
      if (this.manuallyClosed) {
        this.setState("offline");
      } else {
        this.setState("reconnecting", "Conexão com o broker perdida. Tentando reconectar...");
      }
    });

    this.client.on("offline", () => {
      if (!this.manuallyClosed) this.setState("reconnecting", "Broker offline. Tentando reconectar...");
    });

    this.client.on("error", (error: Error) => {
      if (!this.manuallyClosed) this.setState("reconnecting", `MQTT: ${error.message}`);
    });

    this.client.on("message", (topic: string, payload: Uint8Array) => {
      const decoded = new TextDecoder().decode(payload);
      for (const listener of this.messageListeners) {
        listener({ topic, payload: decoded });
      }
    });
  }

  disconnect(): void {
    this.manuallyClosed = true;
    const client = this.client;
    this.client = undefined;

    if (!client) {
      this.setState("offline");
      return;
    }

    client.end(false, {}, () => this.setState("offline"));
  }

  subscribe(topic: string): void {
    this.subscriptions.add(topic);
    if (!this.client?.connected) return;

    this.client.subscribe(topic, { qos: 0 }, (error?: Error | null) => {
      if (error) this.setState("online", `Falha ao entrar no tópico: ${error.message}`);
    });
  }

  publish(topic: string, payload: string): void {
    if (!this.client?.connected) return;
    this.client.publish(topic, payload, { qos: 0, retain: false });
  }

  private setState(state: MqttConnectionState, detail?: string): void {
    this.state = state;
    for (const listener of this.stateListeners) listener(state, detail);
  }
}
