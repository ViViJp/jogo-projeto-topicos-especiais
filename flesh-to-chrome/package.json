{
  "name": "flesh-to-chrome",
  "version": "0.4.2",
  "description": "Flesh to Chrome - 2D cyberpunk auto-runner (academic project prototype)",
  "private": true,
  "scripts": {
    "start": "FTC_ENABLE_TEST_MENU=1 parcel src/index.html --open --no-cache",
    "dev": "FTC_ENABLE_TEST_MENU=1 parcel src/index.html --no-cache",
    "dev:network": "FTC_ENABLE_TEST_MENU=1 parcel src/index.html --host 0.0.0.0 --no-cache",
    "dev:multiplayer": "node server/start-multiplayer-dev.mjs",
    "signaling": "node server/signaling-server.mjs",
    "build": "parcel build src/index.html --dist-dir dist --no-cache",
    "typecheck": "tsc --noEmit",
    "validate:assets": "node scripts/validate-assets.mjs",
    "test:gameplay": "node scripts/test-gameplay-flow.mjs",
    "test:narrative": "node scripts/test-narrative-flow.mjs",
    "test:multiplayer": "node scripts/test-multiplayer-protocol.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "parcel": "^2.12.0",
    "process": "^0.11.10",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "ws": "^8.22.1",
    "mqtt": "^5.14.1"
  }
}
